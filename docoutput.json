{
  "PolicySchedule": {
    "DocumentMetadata": {
      "DocumentType": "string",
      "FormReference": "string",
      "InsuranceProvider": "string",
      "PageCount": "integer",
      "ExtractionWarning": "string or null"
    },
    "CoverageScope": {
      "ScopeStatementText": "string — verbatim note defining who/what is covered, typically printed under the document title",
      "AppliesToSections": "string — e.g. 'One to Seven'"
    },
    "PolicyHolder": {
      "InsuredName": "string",
      "InsuredAddressLine1": "string",
      "InsuredAddressLine2": "string or null",
      "InsuredCity": "string",
      "InsuredCounty": "string",
      "InsuredPostcode": "string"
    },
    "InsurerDetails": {
      "PrimaryInsurer": "string",
      "PrimaryInsurerSectionsCovered": "string",
      "SecondaryInsurer": "string or null",
      "SecondaryInsurerSectionsCovered": "string or null"
    },
    "PolicyIdentifiers": {
      "CertificateOfInsuranceNumber": "string",
      "MembershipNumber": "string"
    },
    "PolicyPeriod": {
      "PeriodStartDate": "string, as written in document",
      "PeriodEndDate": "string, as written in document"
    },
    "PremiumDetails": {
      "MonthlyPremiumAmount": "number",
      "Currency": "string",
      "AdministrationFeeMultiSection": "number or null",
      "AdministrationFeeSingleSection": "number or null",
      "LegalExpensesFee": "number or null",
      "IPTRatePercent": "number or null"
    },
    "CoverSections": [
      {
        "SectionNumber": "string — e.g. 'One'",
        "LineItems": [
          {
            "ItemDescription": "string",
            "LimitDisplayValue": "string — exactly as printed, e.g. '£3000', 'Included'",
            "LimitAmount": "number or null — null if LimitType is not a monetary figure",
            "LimitType": "string — one of: 'MonetaryLimit', 'Included', 'NotOptedIn'",
            "Currency": "string"
          }
        ]
      }
    ],
    "ItemisedValuables": {
      "ThresholdRules": {
        "GeneralItemThreshold": "number",
        "MobilePhoneThreshold": "number",
        "ThresholdRuleText": "string, verbatim"
      },
      "TableIsPopulated": "boolean",
      "Items": [
        {
          "ItemDescription": "string",
          "ItemValue": "number",
          "ItemCategory": "string or null — e.g. 'Jewellery', 'Watch', 'Mobile Phone', 'Other'",
          "ExceedsApplicableThreshold": "boolean",
          "LinkedExcessBand": "string or null"
        }
      ]
    },
    "ContentsLocation": {
      "ContentsAddressSameAsInsured": "boolean",
      "AlternateContentsAddress": "string or null",
      "ContentsLocationNoteText": "string — verbatim note, e.g. 'Contents are insured at the address shown above unless otherwise agreed.'"
    },
    "Endorsements": {
      "HasEndorsements": "boolean",
      "FreeTextEndorsements": [
        {
          "EndorsementTitle": "string or null",
          "EndorsementText": "string",
          "EndorsementCode": "string or null"
        }
      ],
      "ExcessTerms": {
        "PresentAsEndorsement": "boolean",
        "IntroText": "string — verbatim intro sentence(s) explaining what excess is",
        "StandardExcess": "number or null",
        "MobilePhoneExcess": "number or null",
        "JewelleryWatchExcessBands": [
          {
            "ValueRangeLow": "number",
            "ValueRangeHigh": "number",
            "ExcessAmount": "number"
          }
        ],
        "ContentsInStorageStandardExcess": "number or null",
        "ContentsInStorageAccidentalDamageExcess": "number or null",
        "ExcessVariabilityNote": "string or null"
      },
      "AdjustmentsClause": {
        "PresentAsEndorsement": "boolean",
        "AdjustmentsText": "string or null",
        "TriggerEventsListed": ["string"]
      }
    },
    "DeclarationAndSignature": {
      "SignaturePresent": "boolean",
      "SignatureDate": "string or null"
    },
    "StatementOfFact": {
      "UnderinsuranceAverageClause": {
        "ClausePresent": "boolean",
        "ClauseText": "string — verbatim, describes reduced claim payment if sum insured is inadequate ('average')"
      },
      "DeclarationQuestions": [
        {
          "QuestionText": "string, verbatim",
          "Answer": "boolean or null"
        }
      ],
      "YesAnswerDisclosureDetails": "string or null — free text from 'Where you have answered yes, details are shown below' box",
      "ChangesInCircumstancesObligation": {
        "ObligationText": "string, verbatim",
        "TriggerEventsListed": ["string"]
      },
      "FraudPreventionNotice": {
        "NoticePresent": "boolean",
        "DataSharingWithAuthoritiesDisclosed": "boolean",
        "FraudDatabaseCheckDisclosed": "boolean"
      },
      "ClaimsHistoryDisclosureRequirement": {
        "RequirementText": "string, verbatim — obligation to disclose insurance-related incidents",
        "DatabaseSearchAtRenewalOrClaimDisclosed": "boolean"
      },
      "ClaimsDisclosedByPolicyholder": "string or null — free text from 'Claims that you have disclosed' box"
    }
  }
}
